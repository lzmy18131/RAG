# RAG 环境变量示例（复制为 .env 使用）
# 完整配置见 src/config/settings.py；与 pyproject.toml / docker-compose.yml / README 保持一致。

# ── 应用 ──
APP_ENV=development            # development / testing / production
APP_HOST=127.0.0.1
APP_PORT=8000
# DEMO_MODE=true = 无 API key / GPU / 模型下载的确定性演示链路（Stub 模型 + 内置合成语料）
DEMO_MODE=false
LOG_LEVEL=INFO
LOG_FORMAT=text                # text / json
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ── 上传安全 ──
MAX_UPLOAD_MB=50
MAX_PDF_PAGES=500

# ── 并发上限（进程内信号量）──
MAX_CONCURRENT_QUERIES=4
MAX_CONCURRENT_RERANKS=4

# ── LLM（OpenAI 兼容端点；DEMO_MODE=true 时无需填写）──
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_API_KEY=replace-me
LLM_MODEL=deepseek-chat

# ── VLM（Qwen3-VL 等；DEMO_MODE=true 时无需填写）──
VLM_BASE_URL=https://your-vlm-endpoint/v1
VLM_API_KEY=replace-me
VLM_MODEL=qwen3-vl-32b

# ── 本地模型（DEMO_MODE=true 时不加载）──
EMBEDDING_MODEL=BAAI/bge-m3
RERANKER_MODEL=BAAI/bge-reranker-large
MODEL_DEVICE=auto              # auto / cuda / cpu

# ── Milvus Lite ──
MILVUS_URI=milvus.db

# ── LLM Gateway ──
LLM_TIMEOUT=60.0
LLM_MAX_RETRIES=2
LLM_CIRCUIT_THRESHOLD=3
LLM_CIRCUIT_COOLDOWN=30.0
# 备份 provider（三个都填才启用 failover）
LLM_BASE_URL_2=
LLM_API_KEY_2=
LLM_MODEL_2=
LLM_BASE_URL_3=
LLM_API_KEY_3=
LLM_MODEL_3=

# ── Grounding ──
VERIFIER_MODE=grounding        # grounding（确定性）/ llm（V4 judge）
GROUNDING_SCORER=reranker      # reranker（交叉编码器）/ cosine（BGE-M3）
GROUNDING_SCORER_FLOOR=0.1
GROUNDING_MIN_SUPPORT_RATIO=0.7

# ── Semantic Cache ──
CACHE_ENABLED=true
CACHE_THRESHOLD=0.9
CACHE_TTL_DAYS=                # 留空 = 永不过期
