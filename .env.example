# -RAG- 环境变量示例（复制为 .env 使用；全部为可选，Demo Mode 可留空）
# 完整配置见 src/config/settings.py

# ── LLM（OpenAI 兼容端点）──
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_API_KEY=replace-me
LLM_MODEL=deepseek-chat

# ── VLM（Qwen3-VL 等）──
VLM_BASE_URL=https://your-vlm-endpoint/v1
VLM_API_KEY=replace-me
VLM_MODEL=qwen3-vl-32b

# ── 本地模型 ──
EMBEDDING_MODEL=BAAI/bge-m3
RERANKER_MODEL=BAAI/bge-reranker-large
MODEL_DEVICE=auto            # auto / cuda / cpu

# ── Milvus Lite ──
MILVUS_URI=milvus.db

# ── V7 LLM Gateway ──
LLM_TIMEOUT=60.0
LLM_MAX_RETRIES=2
LLM_CIRCUIT_THRESHOLD=3
LLM_CIRCUIT_COOLDOWN=30.0
# 备份 provider（三个都填才启用 failover）
LLM_BASE_URL_2=
LLM_API_KEY_2=
LLM_MODEL_2=
LLM_BASE_URL_3=
LLM_API_KEY_3=
LLM_MODEL_3=

# ── V6 Grounding ──
VERIFIER_MODE=grounding       # grounding（确定性）/ llm（V4 judge）
GROUNDING_SCORER=reranker     # reranker（交叉编码器）/ cosine（BGE-M3）
GROUNDING_SCORER_FLOOR=0.1
GROUNDING_MIN_SUPPORT_RATIO=0.7

# ── V9 Semantic Cache ──
CACHE_ENABLED=true
CACHE_THRESHOLD=0.9
CACHE_TTL_DAYS=               # 留空 = 永不过期

# ── 应用 ──
LOG_LEVEL=INFO
DATA_DIR=data
STORAGE_DIR=storage

# ── 安全（生产建议）──
# APP_ENV=production
# JWT_SECRET_KEY=change-me   # 预留
# DEMO_MODE=false            # true = 无 API key 演示模式（StubLLM/StubVLM）
